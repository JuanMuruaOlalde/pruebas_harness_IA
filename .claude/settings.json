{
  "permissions": {
    "allow": [
      "Bash(cargo test *)",
      "Bash(cargo build *)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(mv *)",
      "Bash(git add *)"
    ],
    "ask": [
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Edit(/documentacion/**)",
      "Edit(/directrices/**)"
    ]
  },
  "env": { "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1" }
}